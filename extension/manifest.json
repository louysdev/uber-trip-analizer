{
  "manifest_version": 3,
  "name": "Uber Trip Extractor",
  "version": "1.0.0",
  "permissions": [],
  "host_permissions": [
    "https://riders.uber.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://riders.uber.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://louysdev.github.io/*",
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  }
}
